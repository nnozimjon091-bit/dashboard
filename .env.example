# Google Sheets integratsiyasi (ixtiyoriy).
# Bu qiymatlar FAQAT serverda o'qiladi — nomiga NEXT_PUBLIC_ qo'shmang.
#
# Lokalda ishlatish uchun bu faylni .env.local deb nusxalang.
# Vercel'da: Project → Settings → Environment Variables.

# Publish qilingan jadvalning CSV havolasi.
# Jadvalda: File → Share → Publish to web → kerakli varaqni tanlang →
# format sifatida "Comma-separated values (.csv)" → Publish.
# Havola shunday ko'rinishda bo'ladi (gid — varaq raqami):
# https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv
SHEETS_CSV_URL=

# Ixtiyoriy, lekin sayt ochiq bo'lsa tavsiya etiladi.
# O'rnatilsa, /api/sheets faqat shu parol bilan ishlaydi.
SHEETS_SYNC_PASSWORD=
